<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- Simulator builds only (see project.yml). Device builds can carry a CarPlay entitlement only after Apple grants it
     to the team; until then adding it there makes signing fail. -->
<dict>
	<key>com.apple.developer.carplay-voice-based-conversation</key>
	<true/>
</dict>
</plist>
