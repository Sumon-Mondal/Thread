# Production Dockerfile for Thread Cloud Virtual Machine Meeting Bot
FROM node:22-bullseye-slim

# Install latest Chromium and audio/X11 dependencies for headless operation
RUN apt-get update && apt-get install -y --no-install-recommends \
    chromium \
    fonts-ipafont-gothic \
    fonts-wqy-zenhei \
    fonts-thai-tlwg \
    fonts-kacst \
    fonts-freefont-ttf \
    libxss1 \
    dumb-init \
    procps \
    && rm -rf /var/lib/apt/lists/*

ENV PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true \
    PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium \
    NODE_ENV=production

WORKDIR /app

COPY package*.json ./
RUN npm install --omit=dev

COPY . .

# Run with dumb-init to avoid zombie Chromium processes
ENTRYPOINT ["dumb-init", "--"]
CMD ["node", "bot.js"]
