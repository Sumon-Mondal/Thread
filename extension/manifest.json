{
  "manifest_version": 3,
  "name": "Thread — Real-Time Meeting Intelligence",
  "version": "1.0.0",
  "description": "Real-time meeting intelligence for Google Meet, Zoom, and Teams: captions, slide QR decoding, and agent actions.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Open Thread Meeting Cockpit"
  },
  "side_panel": {
    "default_path": "side-panel.html"
  },
  "permissions": [
    "sidePanel",
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://meet.google.com/*",
    "https://*.zoom.us/*",
    "https://teams.microsoft.com/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*",
        "https://*.zoom.us/*",
        "https://teams.microsoft.com/*"
      ],
      "js": ["content-script.js"],
      "run_at": "document_idle"
    }
  ]
}
