{
  "manifest_version": 3,
  "name": "Thread — Real-Time Meeting Intelligence",
  "version": "1.1.0",
  "description": "Reads your Google Meet, Zoom or Teams call — captions, chat, people and slide QR codes — and feeds it to Thread live.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Open Thread beside your meeting"
  },
  "side_panel": {
    "default_path": "side-panel.html"
  },
  "permissions": [
    "sidePanel",
    "storage"
  ],
  "host_permissions": [
    "https://meet.google.com/*",
    "https://*.zoom.us/*",
    "https://teams.microsoft.com/*",
    "https://teams.live.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://*.lovable.app/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*",
        "https://*.zoom.us/*",
        "https://teams.microsoft.com/*",
        "https://teams.live.com/*"
      ],
      "js": ["vendor/jsQR.js", "content-script.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "https://project--51f06c23-f68d-49c7-8a46-ff0969ec8881.lovable.app/*"
      ],
      "js": ["thread-bridge.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
